{
  "schema_version": 1,
  "project": "SkyRing",
  "end_goal": "Elden Ring-style action commitment and combat geometry integrated into Skyrim SE/AE, with Skyrim retaining RPG authority, accepted in CrossOver on Apple Silicon.",
  "authority_order": [
    "Charter.md",
    "architecture.md",
    "AGENTS.md"
  ],
  "first_vertical_slice": "colossal_sword",
  "profiles": {
    "local": {
      "proves": "Synthetic plumbing and host-testable invariants only.",
      "required_gates": [
        "contract",
        "repository_identity",
        "proprietary_data_guard",
        "rust_tests",
        "c_abi",
        "bridge_geometry",
        "owner_data_tool",
        "balance_model",
        "balance_report"
      ]
    },
    "source": {
      "proves": "Local profile plus tests against owner-extracted Elden Ring action data.",
      "inherits": "local",
      "required_gates": [
        "source_data"
      ]
    },
    "release": {
      "proves": "Source profile plus exact-commit Windows artifacts and CrossOver vertical-slice evidence.",
      "inherits": "source",
      "required_gates": [
        "runtime_evidence"
      ]
    }
  },
  "release_acceptance": [
    "input",
    "collision_preserving_movement",
    "animation",
    "outgoing_contact",
    "incoming_evasion_and_blocking",
    "skyrim_native_damage",
    "stamina",
    "hit_stop",
    "deterministic_logs",
    "timing_within_one_frame"
  ],
  "non_goals": [
    "port_elden_ring_absolute_damage",
    "port_elden_ring_hp_or_defence",
    "animate_consumables_before_throwables",
    "prioritize_megafauna_before_combat_platform"
  ],
  "balance_invariants": {
    "maximum_armament_multiplier": 1.15,
    "skyrim_owns_absolute_damage": true,
    "all_weapons_unconditionally_wieldable": true,
    "poise_and_stance_are_separate": true
  },
  "generated_owner_data": {
    "action_table": "core/src/sim/extracted.rs",
    "must_be_ignored": true,
    "must_not_be_tracked": true
  }
}
